<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <meta name="description" content="Snail IDE is a PenguinMod mod that was made to add tons of cool stuff to allow for crazy projects." />
    <meta name="theme-color" content="#D414FF">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <link rel="apple-touch-icon" href="<%= htmlWebpackPlugin.options.root %>images/apple-touch-icon.png">
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
    <% if (htmlWebpackPlugin.options.root === "/" || htmlWebpackPlugin.options.root === "") { %>
      <link rel="manifest" href="<%= htmlWebpackPlugin.options.root %>manifest.webmanifest">
    <% } %>
    <style>
      #splash {
        position: absolute; width: 100%; height: 100%; top: 0; left: 0;
        display: flex; align-items: center; justify-content: center;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: hsla(289, 100%, 54%, 1);
      }
      .tw-loaded #splash, #splash-content { display: none; }
      #splash[splash-theme="dark"] { background-color: #333; color: #fff; }
      #splash-spinner:after {
        content: " "; display: block; width: 64px; height: 64px;
        border-radius: 50%; border: 6px solid; border-color: currentColor transparent currentColor transparent;
        animation: splash-spinner 1.2s linear infinite;
      }
      @keyframes splash-spinner {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>
    <link rel="dns-prefetch" href="https://trampoline.turbowarp.org/">
    <link rel="dns-prefetch" href="https://projects.scratch.mit.edu/">
    <link rel="dns-prefetch" href="https://assets.scratch.mit.edu/">
  </head>
  <body>
    <div id="splash" aria-hidden="true">
      <noscript>
        <h1>Enable JavaScript</h1>
        <img src="https://c.tenor.com/q6_BdkX0qQcAAAAC/tenor.gif" alt="stinker">
      </noscript>
      <div id="splash-content">
        <div id="splash-spinner"></div>
     </div>
    </div>
    <script>
      (function() {
        document.querySelector('#splash-content').style.display = 'block';
        <% if (!htmlWebpackPlugin.options.noTheme) { %>
        try {var localTheme = localStorage.getItem('tw:theme');} catch (e) {}
        if (localTheme ? localTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches) document.querySelector('#splash').setAttribute('splash-theme', 'dark');
        <% } %>
      })();
    </script>
    <script src="./redirect.js"></script>
    <div id="app"></div>

    <% if (htmlWebpackPlugin.options.filename === 'editor.html') { %>
    <style>
      #snail-notes-button {position:fixed;right:16px;bottom:82px;z-index:10000;border:0;border-radius:16px;padding:11px 15px;background:#181b2c;color:white;font:600 13px Arial,sans-serif;box-shadow:0 4px 16px #0005;cursor:pointer}
      #snail-notes-panel {display:none;position:fixed;right:16px;bottom:132px;z-index:10000;width:min(330px,calc(100vw - 32px));background:#1d2030;color:#fff;border:1px solid #6c6c9b;border-radius:14px;padding:15px;box-shadow:0 12px 35px #0008;font:14px Arial,sans-serif}
      #snail-notes-panel.snail-open {display:block}
      #snail-notes-panel h2 {font-size:17px;margin:0 0 7px}
      #snail-notes-panel p {font-size:12px;color:#bfc1d6;margin:0 0 12px}
      #snail-notes-input {box-sizing:border-box;width:100%;height:190px;resize:vertical;background:#10121e;color:white;border:1px solid #777b9c;border-radius:8px;padding:10px;font:13px/1.5 Arial,sans-serif}
      #snail-notes-status {font-size:12px;color:#a5e8b1;margin-top:8px}
      #snail-notes-close {float:right;background:transparent;color:white;border:0;font-size:20px;cursor:pointer}
    </style>
    <button id="snail-notes-button" type="button" aria-controls="snail-notes-panel" aria-expanded="false">📝 Notes</button>
    <section id="snail-notes-panel" aria-label="Project notes">
      <button id="snail-notes-close" type="button" aria-label="Close notes">×</button>
      <h2>📝 Project Notes</h2>
      <p>Write ideas or to-dos. Saved automatically in this browser.</p>
      <textarea id="snail-notes-input" placeholder="Ideas for my project..."></textarea>
      <div id="snail-notes-status" role="status">Ready</div>
    </section>
    <script>
      (function () {
        var button = document.getElementById('snail-notes-button');
        var panel = document.getElementById('snail-notes-panel');
        var close = document.getElementById('snail-notes-close');
        var input = document.getElementById('snail-notes-input');
        var status = document.getElementById('snail-notes-status');
        var key = 'snail-ide:project-notes';
        try { input.value = localStorage.getItem(key) || ''; } catch (e) { status.textContent = 'Browser storage unavailable'; }
        function toggle(open) {
          panel.classList.toggle('snail-open', open);
          button.setAttribute('aria-expanded', String(open));
          if (open) input.focus();
        }
        button.addEventListener('click', function () { toggle(!panel.classList.contains('snail-open')); });
        close.addEventListener('click', function () { toggle(false); });
        input.addEventListener('input', function () {
          try { localStorage.setItem(key, input.value); status.textContent = 'Saved locally ✓'; }
          catch (e) { status.textContent = 'Could not save; copy your notes before closing'; }
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && panel.classList.contains('snail-open')) toggle(false);
        });
      })();
    </script>
    <% } %>
  </body>
</html>
